# Copy to .env and adjust for your environment.
# Consumed by backend/app/config.py (env-driven settings: origins,
# host/port, room TTL) and by docker-compose.yml / docker-compose.dev.yml.

# --- Backend -------------------------------------------------------------
# Host/port Uvicorn binds to inside the container.
CATAN_HOST=0.0.0.0
CATAN_PORT=8000

# Comma-separated list of allowed origins for CORS (REST) and the
# WebSocket handshake's Origin check. In prod this is the public
# origin(s) the frontend is served from; in dev, the Vite dev server.
CATAN_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Minutes an empty/abandoned room is kept before the TTL sweep evicts it.
CATAN_ROOM_TTL_MINUTES=60

# Minutes a finished (GAME_OVER) room lingers for the post-game summary
# before the TTL sweep evicts it.
CATAN_FINISHED_ROOM_TTL_MINUTES=30

# How often (seconds) the room TTL sweep runs.
CATAN_ROOM_SWEEP_INTERVAL_SECONDS=60

# How often (seconds) each active game's stalled-turn-timer background
# task checks whether the current turn should be force-ended. Actual
# idle threshold is per-room, via the turn_timer_seconds game setting.
CATAN_TURN_TIMER_CHECK_INTERVAL_SECONDS=5

# Reserved for a future WS keepalive ping loop; not yet wired to
# anything (uvicorn already sends protocol-level pings).
CATAN_WS_PING_INTERVAL_SECONDS=20

# --- Frontend (build-time, consumed by Vite) ------------------------------
# Base URLs the frontend uses to reach the backend.
#   - docker-compose.yml (prod): leave these as same-origin relative
#     paths. frontend/nginx.conf proxies /api and /ws to the backend
#     container, so the browser never talks to it directly.
#   - docker-compose.dev.yml (Windows/Docker Desktop): these are
#     overridden directly in that file to point at the backend's
#     published localhost port instead, since the Vite dev server
#     (5173) and the backend (8000) are different origins there.
VITE_API_URL=/api
VITE_WS_URL=/ws
