# Copy to .env and adjust for your environment.
# Consumed by backend/app/config.py (env-driven settings) and by
# docker-compose.yml / docker-compose.dev.yml.

# --- Backend ---
CATAN_CORS_ORIGINS=http://localhost:5173
CATAN_HOST=0.0.0.0
CATAN_PORT=8000
# Seconds an empty/abandoned room is kept before the TTL sweep evicts it.
CATAN_ROOM_TTL_SECONDS=3600

# --- Frontend (build-time, consumed by Vite) ---
VITE_WS_URL=ws://localhost:8000
